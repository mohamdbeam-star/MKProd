{
  "name": "MK Prod",
  "short_name": "MK Prod",
  "description": "Team workspace for tasks, budgets, orders and contracts. End-to-end encrypted.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#f3f4fb",
  "theme_color": "#7b68ee",
