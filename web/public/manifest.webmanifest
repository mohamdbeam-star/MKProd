  "categories": ["business", "productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "My approvals", "url": "/#/approvals", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "My tasks", "url": "/#/mine", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Orders & expenses", "url": "/#/orders", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
