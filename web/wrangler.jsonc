{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mkprod",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // API calls go to the Worker; everything else is the React site.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mkprod",
      "database_id": "7f1c1e87-1d59-4b8e-8106-e8256d8aa7a7",
      "migrations_dir": "./migrations"
    }
  ],
  // Encrypted file attachments. `npm run deploy` creates the bucket if it doesn't exist yet.
  // If R2 is not enabled on the Cloudflare account, remove this block: everything else keeps working.
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "mkprod-files" }
  ],
  "vars": {
    // PBKDF2 rounds for accounts created before client-side stretching (legacy upgrade path only).
    "PBKDF2_ITERATIONS": "30000",
    // Outgoing email: Gmail with an App Password. Only the password is a secret:
    //   npx wrangler secret put SMTP_PASS
    "SMTP_HOST": "smtp.gmail.com",
    "SMTP_PORT": "465",
    "SMTP_USER": "mohamd.beam@gmail.com",
    "SMTP_FROM": "mohamd.beam@gmail.com"
  },
  "observability": { "enabled": true }
}
