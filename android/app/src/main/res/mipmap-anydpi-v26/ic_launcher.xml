<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon: the launcher crops the 108dp layers to its own shape (circle, squircle…) and
     can animate them separately. The monochrome layer is the Android 13+ themed icon. All three
     are rendered from scripts/icon/icon.mjs. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
